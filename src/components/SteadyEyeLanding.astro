        <ul class="pricing-features"><li>Everything in Annual</li><li>No commitment</li></ul>
      </div>
      <div class="pricing-card">
        <div class="pricing-name">Lifetime</div>
        <div class="pricing-price">$99.99</div>
        <div class="pricing-period">one-time</div>
        <ul class="pricing-features"><li>Everything, forever</li><li>All future updates</li></ul>
      </div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="final-cta" id="download">
  <div class="container">
    <h2>Stop memorizing scripts.<br>Start making eye contact.</h2>
    <p class="section-desc">One take. Done.</p>
    <a href="https://apps.apple.com/app/steadyeye-teleprompter/id6761066976" target="_blank" rel="noopener" class="app-store-badge">
      <img src="/img/app-store-badge.svg" alt="Download SteadyEye on the App Store" width="120" height="40">
    </a>
  </div>
</section>

<!-- FOOTER -->
<footer>
  <div class="container footer-inner">
    <div class="footer-left">
      <span class="logo"><img src="/img/steadyeye/logo.png" alt="SteadyEye" class="logo-img"> SteadyEye</span>
      <p>Built by <a href="https://bazilier.com" target="_blank" rel="noopener">Kirill Bazilier</a></p>
    </div>
    <div class="footer-links">
      <a href="https://bazilier.github.io/steadyeye-legal/privacy.html" target="_blank" rel="noopener">Privacy</a>
      <a href="https://bazilier.github.io/steadyeye-legal/terms.html" target="_blank" rel="noopener">Terms</a>
    </div>
  </div>
</footer>

<script>
const words=["Every","word","appears","right","here","under","the","camera","so","your","eyes","never","move"];
const el=document.querySelector('.word-display');
let i=0;
function tick(){el.style.opacity='0';setTimeout(()=>{el.textContent=words[i%words.length];el.style.opacity='1';i++;},100);}
setInterval(tick,450);tick();

const io=new IntersectionObserver(es=>{es.forEach(e=>{if(e.isIntersecting)e.target.classList.add('visible');});},{threshold:.12});
document.querySelectorAll('.step,.feature-card,.pricing-card,.comparison-card').forEach(e=>io.observe(e));

window.addEventListener('scroll',()=>{document.querySelector('nav').classList.toggle('scrolled',scrollY>40);});
</script>

