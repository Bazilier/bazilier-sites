---
// SteadyEye landing, in English, Brazilian Portuguese or Latin American
// Spanish (copy in src/i18n/steadyeye.ts). Same visual language as the app's
// paywall and onboarding and the App Store screenshots: near-black ground,
// heavy tight headlines ending in the accent, the monospaced prompter pill
// with its accented focus letter, accent-framed phones, tinted icon tiles.
// Self-contained: does not import global.css (shared with other sites).
import { Image } from 'astro:assets';
import '../styles/steadyeye.css';
import heroPhone from '../assets/steadyeye/hero-phone.png';
import eyes from '../assets/steadyeye/eyes.jpg';
import stepRecord from '../assets/steadyeye/step-record.jpg';
import stepExport from '../assets/steadyeye/step-export.jpg';
import { copy, LANGS, type Lang } from '../i18n/steadyeye';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = copy[lang];
const home = LANGS.find((l) => l.code === lang)!.path;
const appStore = 'https://apps.apple.com/app/steadyeye-teleprompter/id6761066976';
const site = 'https://steadyeye.bazilier.com';
const head = (h: [string, string]) => `${h[0]}<br><span class="se-accent">${h[1]}</span>`;
const eyeSvg = `<svg class="se-eye" viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z"/><circle cx="12" cy="12" r="3.4"/></svg>`;
// The app's line-count toggle: arrow.trianglehead.clockwise around the count.
const linesSvg = (n: number) => `<svg class="se-lc" viewBox="35 40 406 442" aria-hidden="true"><path d="M222 99.2A180.5 180.5 0 1 0 345.6 134.1" fill="none" stroke="currentColor" stroke-width="45" stroke-linecap="round"/><path d="M210 52 282 101 210 150z" fill="currentColor" stroke="currentColor" stroke-width="24" stroke-linejoin="round"/><text x="238" y="284">${n}</text></svg>`;
---

<div class="se" data-words={JSON.stringify(t.words)}>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

  <!-- NAV -->
  <nav class="se-nav">
    <div class="se-wrap se-nav-inner">
      <a href={home} class="se-logo"><img src="/img/steadyeye/logo.png" alt="" width="28" height="28"> SteadyEye</a>
      <div class="se-nav-links">
        <a href="#how">{t.nav.how}</a>
        <a href="#features">{t.nav.features}</a>
        <a href="#faq">{t.nav.faq}</a>
        <span class="se-lang">
          {LANGS.map((l) => (
            <a href={l.path} hreflang={l.hreflang} lang={l.htmlLang} title={l.name} aria-current={l.code === lang ? 'page' : undefined}>{l.label}</a>
          ))}
        </span>
        <a href={appStore} target="_blank" rel="noopener" class="se-nav-cta">{t.nav.download}</a>
      </div>
    </div>
  </nav>

  <!-- HERO -->
  <header class="se-hero">
    <div class="se-wrap se-hero-grid">
      <div class="se-hero-copy">
        <span class="se-chip"><Fragment set:html={eyeSvg} /> {t.hero.chip}</span>
        <h1 class:list={['se-h1', { 'se-h1-long': t.hero.h1Long }]} set:html={head(t.hero.h1)} />
        <p class="se-lead">{t.hero.lead}</p>
        <div class="se-ctas">
          <a href={appStore} target="_blank" rel="noopener" class="se-badge">
            <img src={t.hero.badge} alt={t.hero.badgeAlt} width="162" height="54">
          </a>
          <span class="se-note">{t.hero.note}</span>
        </div>
      </div>
      <div class="se-hero-visual">
        <div class="se-glow" aria-hidden="true"></div>
        <div class="se-hero-shot">
          <Image src={heroPhone} alt={t.hero.phoneAlt} widths={[360, 440, 720, 880]} sizes="(max-width: 860px) 86vw, 440px" format="webp" quality={82} loading="eager" fetchpriority="high" class="se-hero-phone" />
          <!-- Live three-line prompter laid over the photo's own pill text -->
          <div class="se-hero-pill" aria-hidden="true"><div class="se-lines" data-lines="3"></div></div>
        </div>
      </div>
    </div>
  </header>

  <!-- PROBLEM -->
  <section class="se-section">
    <div class="se-wrap se-split">
      <div>
        <h2 class="se-h2" set:html={head(t.problem.h2)} />
        <p class="se-body">{t.problem.body}</p>
      </div>
      <Image src={eyes} alt={t.problem.eyesAlt} widths={[480, 640, 1000]} sizes="(max-width: 860px) 92vw, 520px" format="webp" quality={80} class="se-eyes" />
    </div>
  </section>

  <!-- HOW IT WORKS: five steps, each with its own visual -->
  <section class="se-section" id="how">
    <div class="se-wrap">
      <h2 class="se-h2" set:html={head(t.how.h2)} />
      <ol class="se-how">

        <li class="se-how-step">
          <div class="se-how-text">
            <span class="se-step-num">01</span>
            <h3>{t.how.s1.h3}</h3>
            <p class="se-muted">{t.how.s1.p}</p>
          </div>
          <div class="se-how-visual" aria-hidden="true">
            <div class="se-modes">
              <figure class="se-mode">
                <figcaption>{t.how.s1.notesLabel}</figcaption>
                <div class="se-editor se-editor-card">
                  <p class="se-editor-body">{t.how.s1.notes}</p>
                </div>
              </figure>
              <figure class="se-mode">
                <figcaption><span class="se-accent">✦</span> {t.how.s1.readyLabel}</figcaption>
                <div class="se-editor se-editor-card se-editor-clean">
                  {t.how.s1.ready.map((line) => <p>{line}</p>)}
                </div>
              </figure>
            </div>
          </div>
        </li>

        <li class="se-how-step">
          <div class="se-how-text">
            <span class="se-step-num">02</span>
            <h3>{t.how.s2.h3}</h3>
            <p class="se-muted">{t.how.s2.p}</p>
          </div>
          <div class="se-how-visual" aria-hidden="true">
            <div class="se-photo se-record">
              <Image src={stepRecord} alt="" widths={[400, 600, 930]} sizes="(max-width: 860px) 92vw, 370px" format="webp" quality={80} />
              <div class="se-record-ui"><span class="se-rec-btn"><b></b></span><span>{t.how.s2.overlay}</span></div>
            </div>
          </div>
        </li>

        <li class="se-how-step">
          <div class="se-how-text">
            <span class="se-step-num">03</span>
            <h3>{t.how.s3.h3}</h3>
            <p class="se-muted">{t.how.s3.p}</p>
          </div>
          <div class="se-how-visual">
          <div class="se-modes" aria-hidden="true">
            <figure class="se-mode">
              <figcaption>{t.how.s3.one}</figcaption>
              <div class="se-stage">
                <div class="se-pill">
                  <div class="se-pill-top"><Fragment set:html={eyeSvg} /><span class="se-rec"></span><Fragment set:html={linesSvg(1)} /></div>
                  <div class="se-lines" data-lines="1"></div>
                </div>
              </div>
            </figure>
            <figure class="se-mode">
              <figcaption>{t.how.s3.three}</figcaption>
              <div class="se-stage">
                <div class="se-pill">
                  <div class="se-pill-top"><Fragment set:html={eyeSvg} /><span class="se-rec"></span><Fragment set:html={linesSvg(3)} /></div>
                  <div class="se-lines" data-lines="3"></div>
                </div>
              </div>
            </figure>
          </div>
          </div>
        </li>

        <li class="se-how-step">
          <div class="se-how-text">
            <span class="se-step-num">04</span>
            <h3>{t.how.s4.h3} <span class="se-tag">{t.how.s4.tag}</span></h3>
            <p class="se-muted">{t.how.s4.p}</p>
          </div>
          <div class="se-how-visual" aria-hidden="true">
            <div class="se-sound">
              <div class="se-wave-row"><span>{t.how.s4.original}</span><div class="se-wave se-wave-noisy"><i style="--h:22%"></i><i style="--h:64%"></i><i style="--h:30%"></i><i style="--h:81%"></i><i style="--h:18%"></i><i style="--h:55%"></i><i style="--h:92%"></i><i style="--h:35%"></i><i style="--h:70%"></i><i style="--h:26%"></i><i style="--h:60%"></i><i style="--h:88%"></i><i style="--h:40%"></i><i style="--h:75%"></i><i style="--h:20%"></i><i style="--h:58%"></i><i style="--h:95%"></i><i style="--h:33%"></i><i style="--h:66%"></i><i style="--h:28%"></i><i style="--h:84%"></i><i style="--h:45%"></i><i style="--h:72%"></i><i style="--h:24%"></i><i style="--h:62%"></i><i style="--h:90%"></i><i style="--h:38%"></i><i style="--h:68%"></i></div></div>
              <div class="se-wave-row"><span class="se-accent">{t.how.s4.studio}</span><div class="se-wave se-wave-clean"><i style="--h:8%"></i><i style="--h:40%"></i><i style="--h:52%"></i><i style="--h:60%"></i><i style="--h:46%"></i><i style="--h:10%"></i><i style="--h:6%"></i><i style="--h:44%"></i><i style="--h:58%"></i><i style="--h:66%"></i><i style="--h:50%"></i><i style="--h:12%"></i><i style="--h:7%"></i><i style="--h:48%"></i><i style="--h:62%"></i><i style="--h:70%"></i><i style="--h:54%"></i><i style="--h:14%"></i><i style="--h:6%"></i><i style="--h:42%"></i><i style="--h:56%"></i><i style="--h:64%"></i><i style="--h:48%"></i><i style="--h:10%"></i><i style="--h:8%"></i><i style="--h:46%"></i><i style="--h:60%"></i><i style="--h:52%"></i></div></div>
              <div class="se-sound-controls"><span class="se-sparkle-btn"><svg viewBox="0 0 24 24"><path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"/><path d="M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8z"/></svg></span><span class="se-save-btn">{t.how.s4.save}</span></div>
            </div>
          </div>
        </li>

        <li class="se-how-step">
          <div class="se-how-text">
            <span class="se-step-num">05</span>
            <h3>{t.how.s5.h3}</h3>
            <p class="se-muted">{t.how.s5.p}</p>
          </div>
          <div class="se-how-visual" aria-hidden="true">
            <div class="se-photo se-export">
              <Image src={stepExport} alt="" widths={[400, 600, 861]} sizes="(max-width: 860px) 92vw, 370px" format="webp" quality={80} />
              <span class="se-toast"><b>✓</b> {t.how.s5.toast}</span>
              <div class="se-platforms"><span>Reels</span><span>TikTok</span><span>Shorts</span><span>YouTube</span><span>LinkedIn</span></div>
            </div>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- FEATURES -->
  <section class="se-section" id="features">
    <div class="se-wrap">
      <h2 class="se-h2" set:html={head(t.features.h2)} />
      <div class="se-features">
        {t.features.items.map((f) => (
          <div class="se-feature">
            <span class="se-tile" aria-hidden="true">
              {f.icon === 'word' && <svg viewBox="0 0 24 24"><rect x="3" y="7" width="18" height="10" rx="5"/><path d="M8 12h8"/></svg>}
              {f.icon === 'eye' && <svg viewBox="0 0 24 24"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>}
              {f.icon === 'wave' && <svg viewBox="0 0 24 24"><path d="M2 10v4M6 6v12M10 3v18M14 8v8M18 5v14M22 10v4"/></svg>}
              {f.icon === 'sparkles' && <svg viewBox="0 0 24 24"><path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"/><path d="M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8z"/></svg>}
              {f.icon === 'video' && <svg viewBox="0 0 24 24"><rect x="2" y="6" width="14" height="12" rx="3"/><path d="M16 10l6-3v10l-6-3"/></svg>}
              {f.icon === 'mic' && <svg viewBox="0 0 24 24"><rect x="9" y="2" width="6" height="12" rx="3"/><path d="M5 10a7 7 0 0 0 14 0M12 17v5"/></svg>}
              {f.icon === 'globe' && <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20"/></svg>}
              {f.icon === 'drop' && <svg viewBox="0 0 24 24"><path d="M12 2.7s7 7.6 7 12.3a7 7 0 0 1-14 0c0-4.7 7-12.3 7-12.3z"/></svg>}
            </span>
            <p class="se-feature-text">
              <strong>{f.title}</strong>
              {f.tag && <span class="se-tag">{f.tag}</span>}
              <span class="se-muted"> {f.body}</span>
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="se-section" id="faq">
    <div class="se-wrap se-faq">
      <h2 class="se-h2" set:html={head(t.faq.h2)} />
      <div class="se-faq-list">
        {t.faq.items.map(([q, a]) => (
          <details class="se-faq-item">
            <summary>{q}</summary>
            <p class="se-muted">{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="se-final">
    <div class="se-wrap">
      <h2 class="se-h1" set:html={head(t.final.h2)} />
      <p class="se-lead">{t.final.lead}</p>
      <a href={appStore} target="_blank" rel="noopener" class="se-badge">
        <img src={t.hero.badge} alt={t.hero.badgeAlt} width="162" height="54">
      </a>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="se-footer">
    <div class="se-wrap se-footer-inner">
      <span class="se-logo"><img src="/img/steadyeye/logo.png" alt="" width="24" height="24"> SteadyEye</span>
      <p class="se-muted">{t.footer.builtBy} <a href="https://bazilier.com" target="_blank" rel="noopener">Kirill Bazilier</a></p>
      <div class="se-footer-links">
        {LANGS.filter((l) => l.code !== lang).map((l) => <a href={l.path} hreflang={l.hreflang} lang={l.htmlLang}>{l.name}</a>)}
        <a href="/privacy">{t.footer.privacy}</a>
        <a href="/terms">{t.footer.terms}</a>
      </div>
    </div>
  </footer>
</div>

<script>
  // All prompter pills step through the same words. As in the app, each
  // word's focus letter (ORPAlignment.swift: orpIndex) sits in the middle
  // column, straight under the camera; in three-line mode the previous and
  // next words are dimmed, their focus letters in the same column.
  // The words come from the page's language (data-words on .se).
  const words: string[] = JSON.parse(document.querySelector<HTMLElement>('.se')?.dataset.words ?? '[]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function orpIndex(word: string): number {
    const lead = word.length - word.replace(/^\p{P}+/u, '').length;
    const len = word.replace(/^\p{P}+|\p{P}+$/gu, '').length;
    const idx = len <= 1 ? 0 : len <= 5 ? 1 : len <= 9 ? 2 : len <= 13 ? 3 : 4;
    return Math.min(lead + idx, Math.max(0, word.length - 1));
  }

  function line(word: string, dim: boolean): HTMLElement {
    const row = document.createElement('div');
    row.className = dim ? 'se-line se-line-dim' : 'se-line';
    const i = orpIndex(word);
    for (const [cls, text] of [['se-before', word.slice(0, i)], ['se-focus', word[i] ?? ''], ['se-after', word.slice(i + 1)]]) {
      const span = document.createElement('span');
      span.className = cls;
      span.textContent = text;
      row.append(span);
    }
    return row;
  }

  // Every pill on the page — the hero phone and step 3's two — in step.
  const ones = document.querySelectorAll<HTMLElement>('.se-lines[data-lines="1"]');
  const threes = document.querySelectorAll<HTMLElement>('.se-lines[data-lines="3"]');
  let n = 0;
  function show() {
    const at = (k: number) => words[(k + words.length) % words.length];
    ones.forEach((el) => el.replaceChildren(line(at(n), false)));
    threes.forEach((el) => el.replaceChildren(line(at(n - 1), true), line(at(n), false), line(at(n + 1), true)));
  }
  show();
  if (!reduce) setInterval(() => { if (!document.hidden) { n = (n + 1) % words.length; show(); } }, 500);

  const nav = document.querySelector('.se-nav');
  window.addEventListener('scroll', () => nav?.classList.toggle('se-nav-scrolled', window.scrollY > 24), { passive: true });
</script>

<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org', '@type': 'MobileApplication', name: 'SteadyEye', alternateName: 'SteadyEye Teleprompter',
  url: site + home, inLanguage: LANGS.find((l) => l.code === lang)!.htmlLang,
  operatingSystem: 'iOS 17+', applicationCategory: 'MultimediaApplication',
  downloadUrl: appStore, installUrl: appStore, image: site + t.meta.ogImage,
  description: t.ld.description, featureList: t.ld.featureList,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: { '@type': 'Person', name: 'Kirill Vasilyev' },
})} />

<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org', '@type': 'FAQPage', inLanguage: LANGS.find((l) => l.code === lang)!.htmlLang,
  mainEntity: t.faq.items.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
})} />
