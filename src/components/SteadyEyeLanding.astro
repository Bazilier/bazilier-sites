---
// SteadyEye landing. Same visual language as the app's paywall and
// onboarding and the App Store screenshots: near-black ground, heavy tight
// headlines ending in the accent, the monospaced prompter pill with its
// accented focus letter, accent-framed phones, tinted icon tiles.
// Self-contained: does not import global.css (shared with other sites).
import '../styles/steadyeye.css';

const appStore = 'https://apps.apple.com/app/steadyeye-teleprompter/id6761066976';

const features = [
  { icon: 'word', title: 'One word, under the lens.', body: 'Your script appears right where the camera is. Prefer more context? Switch to three lines.' },
  { icon: 'eye', title: 'Eye-contact score.', body: 'After every take, see how much of it you held the camera’s gaze.' },
  { icon: 'wave', title: 'Studio sound.', body: 'Your voice without background noise or echo. One tap after recording.', tag: 'New' },
  { icon: 'sparkles', title: 'AI scripts.', body: 'Paste messy notes or just a topic. Get a script that’s ready to read aloud.' },
  { icon: 'video', title: '4K, stabilized.', body: 'Sharp and steady front-camera video, at the frame rate you pick.' },
  { icon: 'mic', title: 'Any microphone.', body: 'AirPods, Bluetooth, wired or DJI. Plug in and record.' },
  { icon: 'globe', title: 'Any language.', body: 'Spanish to Russian, Arabic to Japanese — with proper right-to-left and CJK support.' },
  { icon: 'drop', title: 'No watermark.', body: 'With a subscription, post your takes exactly as they are.' },
];
---

<div class="se">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

  <!-- NAV -->
  <nav class="se-nav">
    <div class="se-wrap se-nav-inner">
      <a href="/" class="se-logo"><img src="/img/steadyeye/logo.png" alt="" width="28" height="28"> SteadyEye</a>
      <div class="se-nav-links">
        <a href="#how">How it works</a>
        <a href="#features">Features</a>
        <a href={appStore} target="_blank" rel="noopener" class="se-nav-cta">Download</a>
      </div>
    </div>
  </nav>

  <!-- HERO -->
  <header class="se-hero">
    <div class="se-wrap se-hero-grid">
      <div class="se-hero-copy">
        <span class="se-chip"><svg class="se-eye" viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z"/><circle cx="12" cy="12" r="3.4"/></svg> AI eye-contact tracking</span>
        <h1 class="se-h1">Teleprompter<br>for real<br><span class="se-accent">eye contact.</span></h1>
        <p class="se-lead">SteadyEye shows your script one word at a time, right under the camera lens. Your eyes stay locked. Your audience sees confidence, not reading.</p>
        <div class="se-ctas">
          <a href={appStore} target="_blank" rel="noopener" class="se-badge">
            <img src="/img/steadyeye/app-store-badge.svg" alt="Download SteadyEye on the App Store" width="162" height="54">
          </a>
          <span class="se-note">Free to start · iPhone</span>
        </div>
      </div>
      <div class="se-hero-visual">
        <div class="se-glow" aria-hidden="true"></div>
        <img src="/img/steadyeye/store/hero-phone.png" alt="SteadyEye recording screen in three-line mode: “my eyes stay” right under the front camera" width="721" height="1100" class="se-hero-phone">
      </div>
    </div>
  </header>

  <!-- PROBLEM -->
  <section class="se-section">
    <div class="se-wrap se-split">
      <div>
        <h2 class="se-h2">No more<br>wandering<br><span class="se-accent">eyes.</span></h2>
        <p class="se-body">Scrolling text makes your eyes scan left to right, and viewers notice instantly. SteadyEye keeps every word in one spot under the lens, so you look at your audience the whole time.</p>
      </div>
      <img src="/img/steadyeye/store/eyes.jpg" alt="Eyes reading scrolling text drift sideways; with SteadyEye they look straight into the camera" width="1000" height="901" loading="lazy" class="se-eyes">
    </div>
  </section>

  <!-- HOW IT WORKS: five steps, each with its own visual -->
  <section class="se-section" id="how">
    <div class="se-wrap">
      <h2 class="se-h2">Notes in.<br><span class="se-accent">Video out.</span></h2>
      <ol class="se-how">

        <li class="se-how-step">
          <div class="se-how-text">
            <span class="se-step-num">01</span>
            <h3>Add your script — or generate one.</h3>
            <p class="se-muted">Paste notes as messy as you like, or give AI a topic. Either way you get a script that’s easy to read aloud.</p>
          </div>
          <div class="se-how-visual" aria-hidden="true">
            <div class="se-editor">
              <div class="se-editor-bar"><span class="se-accent">Cancel</span><b>New Script</b><span class="se-accent">Save</span></div>
              <p class="se-editor-title">Landing page</p>
              <p class="se-editor-body">landing page — 5 parts and most people get the proportions completely wrong. Headline = 5% of the page. Pain points — 15%. Benefits = 20%. Product — 40%!!! And the Offer w/ CTA — 20%.</p>
              <p class="se-editor-body">most founders spend 80% on product &amp; skip pain + benefits… that’s why nobody converts.</p>
              <p class="se-editor-meta">51 words · 272 characters</p>
              <div class="se-editor-actions">
                <span class="se-btn-accent"><svg viewBox="0 0 24 24"><path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"/></svg> Optimize</span>
                <span class="se-btn-ghost">Write from a topic</span>
              </div>
            </div>
          </div>
        </li>

        <li class="se-how-step">
          <div class="se-how-text">
            <span class="se-step-num">02</span>
            <h3>Hit record.</h3>
            <p class="se-muted">Front camera in up to 4K, stabilized, with whatever mic you have — AirPods, wired or DJI.</p>
          </div>
          <div class="se-how-visual" aria-hidden="true">
            <div class="se-photo se-record">
              <img src="/img/steadyeye/store/step-record.jpg" alt="" width="930" height="1000" loading="lazy">
              <div class="se-record-ui"><span class="se-rec-btn"><b></b></span><span>One take. Done.</span></div>
            </div>
          </div>
        </li>

        <li class="se-how-step">
          <div class="se-how-text">
            <span class="se-step-num">03</span>
            <h3>Read without looking away.</h3>
            <p class="se-muted">Words appear one at a time right under the lens — or three lines, if you like more context. Your eyes stay on the camera.</p>
          </div>
          <div class="se-how-visual">
          <div class="se-modes" aria-hidden="true">
            <figure class="se-mode">
              <figcaption>1 line</figcaption>
              <div class="se-stage">
                <div class="se-pill">
                  <div class="se-pill-top"><svg class="se-eye" viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z"/><circle cx="12" cy="12" r="3.4"/></svg><span class="se-rec"></span><span class="se-chev"></span></div>
                  <div class="se-lines" data-lines="1"></div>
                </div>
              </div>
            </figure>
            <figure class="se-mode">
              <figcaption>3 lines</figcaption>
              <div class="se-stage">
                <div class="se-pill">
                  <div class="se-pill-top"><svg class="se-eye" viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z"/><circle cx="12" cy="12" r="3.4"/></svg><span class="se-rec"></span><span class="se-chev"></span></div>
                  <div class="se-lines" data-lines="3"></div>
                </div>
              </div>
            </figure>
          </div>
          </div>
        </li>

        <li class="se-how-step">
          <div class="se-how-text">
            <span class="se-step-num">04</span>
            <h3>Make it sound like a studio. <span class="se-tag">New</span></h3>
            <p class="se-muted">One tap removes background noise and echo and evens out your voice. Flip between the original and Studio to hear the difference.</p>
          </div>
          <div class="se-how-visual" aria-hidden="true">
            <div class="se-sound">
              <div class="se-wave-row"><span>Original</span><div class="se-wave se-wave-noisy"><i style="--h:22%"></i><i style="--h:64%"></i><i style="--h:30%"></i><i style="--h:81%"></i><i style="--h:18%"></i><i style="--h:55%"></i><i style="--h:92%"></i><i style="--h:35%"></i><i style="--h:70%"></i><i style="--h:26%"></i><i style="--h:60%"></i><i style="--h:88%"></i><i style="--h:40%"></i><i style="--h:75%"></i><i style="--h:20%"></i><i style="--h:58%"></i><i style="--h:95%"></i><i style="--h:33%"></i><i style="--h:66%"></i><i style="--h:28%"></i><i style="--h:84%"></i><i style="--h:45%"></i><i style="--h:72%"></i><i style="--h:24%"></i><i style="--h:62%"></i><i style="--h:90%"></i><i style="--h:38%"></i><i style="--h:68%"></i></div></div>
              <div class="se-wave-row"><span class="se-accent">Studio</span><div class="se-wave se-wave-clean"><i style="--h:8%"></i><i style="--h:40%"></i><i style="--h:52%"></i><i style="--h:60%"></i><i style="--h:46%"></i><i style="--h:10%"></i><i style="--h:6%"></i><i style="--h:44%"></i><i style="--h:58%"></i><i style="--h:66%"></i><i style="--h:50%"></i><i style="--h:12%"></i><i style="--h:7%"></i><i style="--h:48%"></i><i style="--h:62%"></i><i style="--h:70%"></i><i style="--h:54%"></i><i style="--h:14%"></i><i style="--h:6%"></i><i style="--h:42%"></i><i style="--h:56%"></i><i style="--h:64%"></i><i style="--h:48%"></i><i style="--h:10%"></i><i style="--h:8%"></i><i style="--h:46%"></i><i style="--h:60%"></i><i style="--h:52%"></i></div></div>
              <div class="se-sound-controls"><span class="se-sparkle-btn"><svg viewBox="0 0 24 24"><path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"/><path d="M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8z"/></svg></span><span class="se-save-btn">Save to Camera Roll</span></div>
            </div>
          </div>
        </li>

        <li class="se-how-step">
          <div class="se-how-text">
            <span class="se-step-num">05</span>
            <h3>Export and post.</h3>
            <p class="se-muted">Save the take to your Camera Roll and post it wherever your audience is. No watermark with a subscription.</p>
          </div>
          <div class="se-how-visual" aria-hidden="true">
            <div class="se-photo se-export">
              <img src="/img/steadyeye/store/step-export.jpg" alt="" width="861" height="900" loading="lazy">
              <span class="se-toast"><b>✓</b> Saved to Camera Roll</span>
              <div class="se-platforms"><span>Reels</span><span>TikTok</span><span>Shorts</span><span>YouTube</span><span>LinkedIn</span></div>
            </div>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- FEATURES -->
  <section class="se-section" id="features">
    <div class="se-wrap">
      <h2 class="se-h2">Everything for<br><span class="se-accent">one clean take.</span></h2>
      <div class="se-features">
        {features.map((f) => (
          <div class="se-feature">
            <span class="se-tile" aria-hidden="true">
              {f.icon === 'word' && <svg viewBox="0 0 24 24"><rect x="3" y="7" width="18" height="10" rx="5"/><path d="M8 12h8"/></svg>}
              {f.icon === 'eye' && <svg viewBox="0 0 24 24"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>}
              {f.icon === 'wave' && <svg viewBox="0 0 24 24"><path d="M2 10v4M6 6v12M10 3v18M14 8v8M18 5v14M22 10v4"/></svg>}
              {f.icon === 'sparkles' && <svg viewBox="0 0 24 24"><path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"/><path d="M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8z"/></svg>}
              {f.icon === 'video' && <svg viewBox="0 0 24 24"><rect x="2" y="6" width="14" height="12" rx="3"/><path d="M16 10l6-3v10l-6-3"/></svg>}
              {f.icon === 'mic' && <svg viewBox="0 0 24 24"><rect x="9" y="2" width="6" height="12" rx="3"/><path d="M5 10a7 7 0 0 0 14 0M12 17v5"/></svg>}
              {f.icon === 'globe' && <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20"/></svg>}
              {f.icon === 'drop' && <svg viewBox="0 0 24 24"><path d="M12 2.7s7 7.6 7 12.3a7 7 0 0 1-14 0c0-4.7 7-12.3 7-12.3z"/></svg>}
            </span>
            <p class="se-feature-text">
              <strong>{f.title}</strong>
              {f.tag && <span class="se-tag">{f.tag}</span>}
              <span class="se-muted"> {f.body}</span>
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="se-final">
    <div class="se-wrap">
      <h2 class="se-h1">Start recording<br><span class="se-accent">for free.</span></h2>
      <p class="se-lead">Stop memorizing scripts. Start making eye contact.</p>
      <a href={appStore} target="_blank" rel="noopener" class="se-badge">
        <img src="/img/steadyeye/app-store-badge.svg" alt="Download SteadyEye on the App Store" width="162" height="54">
      </a>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="se-footer">
    <div class="se-wrap se-footer-inner">
      <span class="se-logo"><img src="/img/steadyeye/logo.png" alt="" width="24" height="24"> SteadyEye</span>
      <p class="se-muted">Built by <a href="https://bazilier.com" target="_blank" rel="noopener">Kirill Bazilier</a></p>
      <div class="se-footer-links">
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
      </div>
    </div>
  </footer>
</div>

<script>
  // Both prompter pills step through the same words. As in the app, each
  // word's focus letter (ORPAlignment.swift: orpIndex) sits in the middle
  // column, straight under the camera; in three-line mode the previous and
  // next words are dimmed, their focus letters in the same column.
  const words = ['SteadyEye', 'keeps', 'your', 'eyes', 'right', 'under', 'the', 'lens.', 'One', 'word', 'at', 'a', 'time.', 'No', 'more', 'wandering', 'eyes.'];
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function orpIndex(word: string): number {
    const lead = word.length - word.replace(/^\p{P}+/u, '').length;
    const len = word.replace(/^\p{P}+|\p{P}+$/gu, '').length;
    const idx = len <= 1 ? 0 : len <= 5 ? 1 : len <= 9 ? 2 : len <= 13 ? 3 : 4;
    return Math.min(lead + idx, Math.max(0, word.length - 1));
  }

  function line(word: string, dim: boolean): HTMLElement {
    const row = document.createElement('div');
    row.className = dim ? 'se-line se-line-dim' : 'se-line';
    const i = orpIndex(word);
    for (const [cls, text] of [['se-before', word.slice(0, i)], ['se-focus', word[i] ?? ''], ['se-after', word.slice(i + 1)]]) {
      const span = document.createElement('span');
      span.className = cls;
      span.textContent = text;
      row.append(span);
    }
    return row;
  }

  const one = document.querySelector<HTMLElement>('.se-lines[data-lines="1"]');
  const three = document.querySelector<HTMLElement>('.se-lines[data-lines="3"]');
  let n = 0;
  function show() {
    const at = (k: number) => words[(k + words.length) % words.length];
    one?.replaceChildren(line(at(n), false));
    three?.replaceChildren(line(at(n - 1), true), line(at(n), false), line(at(n + 1), true));
  }
  show();
  if (!reduce) setInterval(() => { n = (n + 1) % words.length; show(); }, 480);

  const nav = document.querySelector('.se-nav');
  window.addEventListener('scroll', () => nav?.classList.toggle('se-nav-scrolled', window.scrollY > 24), { passive: true });
</script>

