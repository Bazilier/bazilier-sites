---
// Order matters: steadyeye.css overrides .btn* rules from global.css.
import '../styles/global.css';
import '../styles/steadyeye.css';
---

<!-- NAV -->
<nav>
  <div class="container nav-inner">
    <a href="/" class="logo"><img src="/img/steadyeye/logo.png" alt="SteadyEye" class="logo-img"> SteadyEye</a>
    <div class="nav-links">
      <a href="#how-it-works">How it works</a>
      <a href="#features">Features</a>
      <a href="#pricing">Pricing</a>
      <a href="https://apps.apple.com/app/steadyeye-teleprompter/id6761066976" target="_blank" rel="noopener" class="nav-cta">Download</a>
    </div>
  </div>
</nav>

<!-- HERO -->
<section class="hero">
  <div class="container">
    <div class="hero-badge">Teleprompter for iPhone</div>
    <h1>One word.<br>Right under the lens.</h1>
    <p class="hero-sub">The only teleprompter that shows words one at a time — right where the camera is. Your eyes stay locked. Your audience sees eye contact, not a script reader.</p>

    <div class="word-demo">
      <div class="phone-frame">
        <div class="dynamic-island"></div>
        <div class="word-bar"><span class="word-display"></span></div>
        <div class="phone-label">Your eyes stay here ↑</div>
      </div>
    </div>

    <div class="hero-ctas">
      <a href="https://apps.apple.com/app/steadyeye-teleprompter/id6761066976" target="_blank" rel="noopener" class="app-store-badge">
        <img src="/img/app-store-badge.svg" alt="Download SteadyEye on the App Store" width="120" height="40">
      </a>
      <a href="#how-it-works" class="btn btn-ghost">See how it works</a>
    </div>
  </div>
</section>

<!-- PROBLEM -->
<section class="problem" id="how-it-works">
  <div class="container">
    <div class="section-label">The problem</div>
    <h2>Every teleprompter makes you <em>look</em> like you're reading.</h2>
    <p class="section-desc">Scrolling text forces your eyes to scan left-to-right. Viewers notice instantly — it looks robotic, rehearsed, untrustworthy. Memorizing scripts burns hours and leads to dozens of retakes.</p>

    <div class="comparison">
      <div class="comparison-card bad">
        <div class="comparison-header"><span class="comparison-icon">✕</span> Scrolling teleprompter</div>
        <div class="comparison-visual"><div class="eye-movement scanning"><div class="eye-dot"></div></div></div>
        <p>Eyes scan across lines. Viewers see constant movement.</p>
      </div>
      <div class="comparison-card good">
        <div class="comparison-header"><span class="comparison-icon">✓</span> SteadyEye</div>
        <div class="comparison-visual"><div class="eye-movement steady"><div class="eye-dot"></div></div></div>
        <p>Eyes stay in one spot. Looks like natural eye contact.</p>
      </div>
    </div>
  </div>
</section>

<!-- SOLUTION -->
<section class="how-it-works">
  <div class="container">
    <div class="section-label">The solution</div>
    <h2>Steadicam for your eyes.</h2>
    <p class="section-desc">SteadyEye shows one word at a time in a compact bar under the front camera lens. Your gaze never leaves the camera.</p>

    <div class="steps">
      <div class="step"><div class="step-num">01</div><h3>Paste your script</h3><p>Write or paste any text. AI optimizes it for speaking — expands abbreviations, converts numbers to words, adds pause markers.</p></div>
      <div class="step"><div class="step-num">02</div><h3>Hit record</h3><p>Words appear one at a time under the camera lens. Adjust speed from slow to fast. Works with AirPods, DJI, wired mics.</p></div>
      <div class="step"><div class="step-num">03</div><h3>One take. Done.</h3><p>Record in 4K. Preview instantly. Save or retake. No memorizing, no eye drift, no 47th attempt.</p></div>
    </div>
  </div>
</section>

<!-- SCREENSHOTS -->
<section class="screenshots" id="features">
  <div class="container">
    <div class="section-label">See it in action</div>
    <h2>Built for creators who ship fast.</h2>
  </div>
  <div class="screenshot-scroll">
    <div class="screenshot-card"><img src="/img/steadyeye/01.png" alt="SteadyEye word-by-word mode" loading="lazy"></div>
    <div class="screenshot-card"><img src="/img/steadyeye/02.png" alt="SteadyEye 3-line mode" loading="lazy"></div>
    <div class="screenshot-card"><img src="/img/steadyeye/03.png" alt="AI script optimization" loading="lazy"></div>
    <div class="screenshot-card"><img src="/img/steadyeye/04.png" alt="Bulk import" loading="lazy"></div>
    <div class="screenshot-card"><img src="/img/steadyeye/05.png" alt="Script list" loading="lazy"></div>
  </div>
</section>

<!-- FEATURES -->
<section class="features">
  <div class="container">
    <div class="features-grid">
      <div class="feature-card"><div class="feature-icon">◉</div><h3>Word-by-word display</h3><p>No competitor has this. Text appears one word at a time right under the camera lens. Zero eye drift.</p></div>
      <div class="feature-card"><div class="feature-icon">⚡</div><h3>AI script optimization</h3><p>Converts numbers to words, expands abbreviations, shortens sentences, adds pause markers.</p></div>
      <div class="feature-card"><div class="feature-icon">🎙</div><h3>Any microphone</h3><p>AirPods, Bluetooth, wired, DJI — plug in and go. Zero recording glitches.</p></div>
      <div class="feature-card"><div class="feature-icon mono">4K</div><h3>4K recording</h3><p>Front camera, custom FPS, countdown timer, instant preview with retake or save.</p></div>
      <div class="feature-card"><div class="feature-icon">🌍</div><h3>Any language</h3><p>English, Spanish, German, French, Russian, Arabic — and proper CJK support.</p></div>
      <div class="feature-card"><div class="feature-icon">📋</div><h3>Bulk import</h3><p>Paste a wall of scripts. AI splits and optimizes each one separately.</p></div>
    </div>
  </div>
</section>

