---
import Base from '../layouts/Base.astro';
import '../styles/global.css';
---

<Base
  title="Bazilier — Apps by Kirill"
  description="iOS apps: SteadyEye teleprompter, DoseBoard supplement tracker."
  canonical="https://bazilier.com"
>
  <div class="container" style="padding: 120px 24px; text-align: center;">
    <h1 style="margin-bottom: 24px;">Bazilier</h1>
    <p class="section-desc" style="margin: 0 auto 48px;">iOS apps by Kirill Bazilier</p>

    <div style="display: flex; gap: 20px; justify-content: center; flex-wrap: wrap;">
      <a href="https://steadyeye.bazilier.com" class="btn btn-primary">SteadyEye →</a>
      <a href="https://doseboard.bazilier.com" class="btn btn-ghost">DoseBoard →</a>
    </div>
  </div>
</Base>
