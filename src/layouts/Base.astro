---
interface Props {
  title: string;
  description: string;
  canonical: string;
  ogImage?: string;
  appId?: string;
  gaId?: string;
  faviconPath?: string;
  icon192Path?: string;
  appleTouchIconPath?: string;
}

const {
  title,
  description,
  canonical,
  ogImage,
  appId,
  gaId,
  faviconPath = '/img/steadyeye/favicon.png',
  icon192Path = '/img/steadyeye/favicon-192.png',
  appleTouchIconPath = '/img/steadyeye/apple-touch-icon.png',
} = Astro.props;

// Placeholder IDs must never emit a live gtag config.
const hasGa = Boolean(gaId && !gaId.startsWith('G-XXXX'));
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>

  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonical}>
  {ogImage && <meta property="og:image" content={ogImage}>}
  <meta property="og:locale" content="en_US">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  {ogImage && <meta name="twitter:image" content={ogImage}>}

  <link rel="icon" type="image/png" sizes="32x32" href={faviconPath}>
  <link rel="icon" type="image/png" sizes="192x192" href={icon192Path}>
  <link rel="apple-touch-icon" sizes="180x180" href={appleTouchIconPath}>
  {appId && <meta name="apple-itunes-app" content={`app-id=${appId}`}>}

  {hasGa && (
    <Fragment>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
      <script define:vars={{ gaId }}>
        window.dataLayer=window.dataLayer||[];
        function gtag(){dataLayer.push(arguments);}
        gtag('js',new Date());
        gtag('config', gaId);
      </script>
    </Fragment>
  )}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
</head>
<body>
  <slot />
</body>
</html>
